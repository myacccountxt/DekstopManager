# Ganti seluruh nilai contoh sebelum menjalankan Docker Compose.
# Gunakan password acak base64url, minimal 32 karakter.
POSTGRES_PASSWORD=replace-with-long-random-base64url-secret

# LAN: 0.0.0.0. Untuk Caddy/reverse proxy di host yang sama: 127.0.0.1.
EARSIP_BIND_ADDRESS=0.0.0.0
EARSIP_PORT=3000
EARSIP_MAX_FILE_SIZE=1073741824

EARSIP_ADMIN_USERNAME=admin
EARSIP_ADMIN_PASSWORD=replace-with-unique-password-at-least-8-characters
EARSIP_ORGANIZATION_NAME=E-Arsip Instansi

# Biarkan false kecuali API hanya diakses melalui reverse proxy tepercaya.
EARSIP_TRUST_PROXY=false
