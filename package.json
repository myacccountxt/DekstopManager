{
  "name": "e-arsip-instansi",
  "version": "1.0.0",
  "private": true,
  "description": "E-Arsip Instansi client-server archive application built with Electron, React, Node.js, and PostgreSQL.",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "electron:build": "npm run build && electron-builder",
    "test": "node --test server/migrate-local.test.js server/server-url.test.js",
    "server:start": "node server/index.js",
    "server:bootstrap-admin": "node server/cli.js bootstrap-admin",
    "server:invite": "node server/cli.js invite",
    "server:migrate-local": "node server/migrate-local.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "better-sqlite3": "^13.0.3",
    "form-data": "^4.0.4",
    "lucide-react": "^1.50.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "vite": "^8.3.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.e-arsip.instansi",
    "productName": "E-Arsip Instansi",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "mobile-app-settings.png",
      "verifyUpdateCodeSignature": false,
      "artifactName": "E-Arsip-Instansi-Portable-${version}.${ext}"
    },
    "portable": {
      "artifactName": "E-Arsip-Instansi-Portable.exe",
      "requestExecutionLevel": "user"
    }
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
